rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Reglas para la colección de usuarios (users)
    match /users/{userId} {
      allow read, write: if true;
    }

    // Reglas para la colección de categorías (categories)
    match /categories/{categoryId} {
      allow read, write: if true;
    }

    // Reglas para la colección de servicios (services)
    match /services/{serviceId} {
      allow read, write: if true;
    }

    // Reglas para la colección de tickets (tickets)
    match /tickets/{ticketId} {
      allow read, write: if true;
    }

    // Reglas para la colección de gastos fijos (fixedExpenses)
    match /fixedExpenses/{expenseId} {
      allow read, write: if true;
    }

    // Reglas para la colección de gastos variables (variableExpenses)
    match /variableExpenses/{expenseId} {
      allow read, write: if true;
    }

    // Reglas para la colección de configuración global (settings)
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Reglas para el log de auditoría (auditLogs)
    match /auditLogs/{logId} {
      allow read, write: if true;
    }
  }
}
